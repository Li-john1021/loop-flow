{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "loop-flow/optimization-candidate/1.0",
  "title": "Loop Flow Optimization Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "source_trace_refs", "root_cause_class", "confidence", "observed_facts", "hypothesis", "proposal_type", "proposal", "evaluation_plan", "risk", "status", "user_approval_required"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "candidate_id": { "type": "string", "pattern": "^OPT-[0-9]{3,}$" },
    "source_trace_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^EVT-[0-9]{3,}$" } },
    "root_cause_class": { "enum": ["prompt", "decomposition", "workflow", "capability_mismatch", "environment", "insufficient_evidence"] },
    "confidence": { "enum": ["high", "medium", "low"] },
    "observed_facts": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "hypothesis": { "type": "string", "minLength": 1 },
    "proposal_type": { "enum": ["prompt_change", "split_unit", "merge_units", "model_upgrade", "model_downgrade", "review_rule_change", "environment_fix", "no_change"] },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "changes", "scope"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "changes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "scope": { "enum": ["task", "unit", "cycle", "skill"] }
      }
    },
    "evaluation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held_out", "adversarial", "regression", "success_criteria"],
      "properties": {
        "held_out": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "adversarial": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "regression": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "expected_model_tier": { "enum": ["frontier", "balanced", "economy", "user_selected", "unknown"] },
    "actual_model_id": { "type": "string", "minLength": 1 },
    "capability_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["low", "medium", "high"] },
    "status": { "enum": ["proposed", "testing", "accepted", "rejected", "rolled_back"] },
    "user_approval_required": { "const": true },
    "decision_ref": { "type": "string" }
  }
}
